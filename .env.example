# =============================================================================
# Multi-Agent Agentic RAG Diagnostic Copilot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM Provider -----------------------------------------------------------
# Options: gemini | openai | ollama
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI-compatible
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Medical Vision Provider ------------------------------------------------
# Options: gemini | openai | local | none
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.8-flash

# --- Embedding Model --------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For biomedical: microsoft/BiomedNLP-BiomedBERT-base-uncased-abstract

# --- RAG Settings ------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma_db
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/diagnostic_copilot.db

# --- Backend -----------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ----------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=png,jpg,jpeg
TEMP_IMAGE_DIR=./data/temp_images
